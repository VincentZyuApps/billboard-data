# 行尾规范
* text=auto eol=lf

# 排除海量单期周榜数据文件，避免淹没语言统计
data/weekly/** linguist-detectable=false

# 显式将索引 index.json 纳入 GitHub 语言统计
data/index.json linguist-detectable=true

# 显式将所有 Markdown 文档纳入 GitHub 语言统计
*.md linguist-detectable=true linguist-documentation=false
docs/**/*.md linguist-detectable=true linguist-documentation=false

# 显式将 GitHub Actions 工作流与 YAML 配置文件纳入 GitHub 语言统计
.github/workflows/*.yml linguist-detectable=true
*.yml linguist-detectable=true
*.yaml linguist-detectable=true
