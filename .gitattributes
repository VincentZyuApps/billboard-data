# 行尾规范
* text=auto eol=lf

# 排除海量单期周榜数据文件，避免淹没语言统计
data/**/weekly/** linguist-detectable=false

# 显式将各数据源索引 index.json 纳入 GitHub 语言统计
data/**/index.json linguist-detectable=true

# 显式将所有 Markdown 文档与 README 纳入 GitHub 语言统计
README.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
*.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
docs/**/*.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false

# ⚙️ 将配置文件本身纳入 GitHub Linguist 语言统计
.gitattributes linguist-language=gitattributes linguist-detectable=true linguist-documentation=false -linguist-vendored -linguist-generated

# 取消 .github 目录的 vendored 忽略，并将 Workflow YAML 强制纳入统计
.github/** linguist-vendored=false
.github/workflows/*.yml linguist-detectable=true linguist-language=YAML
*.yml linguist-detectable=true linguist-language=YAML
*.yaml linguist-detectable=true linguist-language=YAML
